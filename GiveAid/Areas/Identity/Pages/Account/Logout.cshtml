@page
@model LogoutModel
@{
    ViewData["Title"] = "Signed Out";
}

<div class="container py-2 py-md-3 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow rounded-4 text-center overflow-hidden">
                <div class="card-header bg-dark text-white py-3 px-3 border-0">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-1" style="width: 38px; height: 38px; font-size: 1.1rem;">
                        <i class="fas fa-sign-out-alt"></i>
                    </div>
                    <h4 class="fw-bold mb-0">Give<span class="text-primary">Aid</span></h4>
                    <span class="text-white-50" style="font-size: 0.8rem;">Account Session</span>
                </div>

                <div class="card-body p-3 p-md-4 bg-white">
                    @{
                        if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <h5 class="fw-bold text-dark mb-1">Ready to Leave?</h5>
                            <p class="text-muted small mb-3" style="font-size: 0.825rem;">Click below to securely end your current session.</p>
                            <form class="d-grid gap-2" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                <button type="submit" class="btn btn-danger fw-semibold py-2">
                                    Confirm Sign Out
                                </button>
                                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                    Cancel & Return
                                </a>
                            </form>
                        }
                        else
                        {
                            <div class="mb-2 text-success" style="font-size: 2.2rem;">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Signed Out Successfully</h5>
                            <p class="text-muted small mb-3" style="font-size: 0.825rem;">
                                You have safely logged out of GiveAid. Thank you for your support!
                            </p>
                            <div class="d-grid gap-2">
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary fw-semibold py-2">
                                    Sign In Again
                                </a>
                                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                    Return to Home
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
