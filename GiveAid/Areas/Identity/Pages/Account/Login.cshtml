@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-2 py-md-3 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <!-- Compact Brand Header -->
                <div class="card-header bg-dark text-white text-center py-3 px-3 border-0">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-1" style="width: 38px; height: 38px; font-size: 1.1rem;">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h4 class="fw-bold mb-0">Give<span class="text-primary">Aid</span></h4>
                    <span class="text-white-50" style="font-size: 0.8rem;">Sign in to your account</span>
                </div>

                <!-- Form Body -->
                <div class="card-body p-3 p-md-4 bg-white">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-2" role="alert"></div>

                        <div class="mb-2">
                            <label asp-for="Input.Email" class="form-label fw-semibold text-secondary small mb-1">Email Address</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Input.Email" id="loginEmail" class="form-control border-start-0 ps-1" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small" style="font-size: 0.75rem;"></span>
                        </div>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Input.Password" class="form-label fw-semibold text-secondary small mb-0">Password</label>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none text-muted" style="font-size: 0.75rem;">Forgot?</a>
                            </div>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                                <input asp-for="Input.Password" id="loginPassword" class="form-control border-start-0 ps-1" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small" style="font-size: 0.75rem;"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                            <label class="form-check-label small text-secondary" for="rememberMeCheck" style="font-size: 0.8rem;">
                                Stay signed in
                            </label>
                        </div>

                        <div class="d-grid mb-2">
                            <button id="login-submit" type="submit" class="btn btn-primary fw-semibold py-2 shadow-sm">
                                Sign In
                            </button>
                        </div>

                        <div class="text-center mt-2 pt-2 border-top">
                            <p class="small text-muted mb-0" style="font-size: 0.825rem;">
                                Don't have an account? 
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Create Account</a>
                            </p>
                        </div>
                    </form>

                    <!-- Quick Demo Login Helpers -->
                    <div class="mt-3 p-2 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-secondary text-uppercase" style="font-size: 0.6rem; letter-spacing: 0.5px;">Quick Test Login</span>
                            <span class="text-muted" style="font-size: 0.7rem;">Click to fill</span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark flex-fill py-1" style="font-size: 0.78rem;" onclick="fillCredentials('admin@giveaid.org', 'Admin@123')">
                                <i class="fas fa-user-tie me-1"></i> Admin
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill py-1" style="font-size: 0.78rem;" onclick="fillCredentials('user@giveaid.org', 'User@123')">
                                <i class="fas fa-user me-1"></i> User
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, password) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
