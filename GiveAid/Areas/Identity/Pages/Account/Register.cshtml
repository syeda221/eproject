@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-2 py-md-3 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <!-- Compact Brand Header -->
                <div class="card-header bg-dark text-white text-center py-3 px-3 border-0">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-1" style="width: 38px; height: 38px; font-size: 1.1rem;">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h4 class="fw-bold mb-0">Give<span class="text-primary">Aid</span></h4>
                    <span class="text-white-50" style="font-size: 0.8rem;">Create your welfare account</span>
                </div>

                <!-- Form Body -->
                <div class="card-body p-3 p-md-4 bg-white">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-1 px-2 small mb-2" role="alert"></div>

                        <div class="mb-2">
                            <label asp-for="Input.Email" class="form-label fw-semibold text-secondary small mb-1">Email Address</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control border-start-0 ps-1" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small" style="font-size: 0.75rem;"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Input.Password" class="form-label fw-semibold text-secondary small mb-1">Password</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control border-start-0 ps-1" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small" style="font-size: 0.75rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-secondary small mb-1">Confirm Password</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-check-double"></i></span>
                                <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 ps-1" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small" style="font-size: 0.75rem;"></span>
                        </div>

                        <div class="d-grid mb-2">
                            <button id="registerSubmit" type="submit" class="btn btn-primary fw-semibold py-2 shadow-sm">
                                Complete Registration
                            </button>
                        </div>

                        <div class="text-center mt-2 pt-2 border-top">
                            <p class="small text-muted mb-0" style="font-size: 0.825rem;">
                                Already have an account? 
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Sign In</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
