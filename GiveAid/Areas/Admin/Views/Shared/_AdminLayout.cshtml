<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GiveAid Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiveAid.styles.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8fafc;
            color: #334155;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .admin-nav .nav-link {
            font-weight: 500;
            font-size: 0.95rem;
            color: #cbd5e1 !important;
            padding: 0.5rem 1rem;
            border-radius: 0.25rem;
            transition: all 0.2s ease;
        }
        .admin-nav .nav-link:hover {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .admin-nav .nav-link.active {
            color: #ffffff !important;
            background-color: #0d6efd;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Admin Header / Navbar (Clean, Text Only) -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2">
            <div class="container">
                <!-- Admin Brand -->
                <a class="navbar-brand fw-bold text-white" asp-area="Admin" asp-controller="NGOs" asp-action="Index">
                    GiveAid Admin
                </a>

                <!-- Mobile Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarContent"
                        aria-controls="adminNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links for All Modules (Clean Plain Text) -->
                <div class="collapse navbar-collapse" id="adminNavbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 admin-nav ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="NGOs" asp-action="Index">NGOs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Causes" asp-action="Index">Causes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Programmes" asp-action="Index">Programmes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Donations" asp-action="Index">Donations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Galleries" asp-action="Index">Galleries</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Queries" asp-action="Index">Queries</a>
                        </li>
                    </ul>

                    <!-- Right Side: View Public Site + Logout -->
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                            View Website
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Admin Footer -->
    <footer class="bg-white border-top py-3 mt-auto text-muted small">
        <div class="container d-flex justify-content-between align-items-center">
            <div>&copy; 2026 GiveAid Portal - Admin Console</div>
            <div>Administrator</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
