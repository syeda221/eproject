@model IEnumerable<GiveAid.Models.Donation>
@{
    ViewData["Title"] = "Donation Records";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Donation Transactions</h3>
            <small class="text-muted">All contributions received through the public giving portal.</small>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white border-start border-4 border-success">
                <small class="text-muted text-uppercase fw-semibold">Total Funds Collected</small>
                <h3 class="fw-bold text-success mb-0 mt-1">PKR @(((decimal)(ViewBag.TotalFunds ?? 0)).ToString("N0"))</h3>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white border-start border-4 border-primary">
                <small class="text-muted text-uppercase fw-semibold">Total Contributions Count</small>
                <h3 class="fw-bold text-dark mb-0 mt-1">@(ViewBag.TotalCount ?? 0) Donations</h3>
            </div>
        </div>
    </div>

    <!-- Donations Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Transaction ID</th>
                        <th>Welfare Cause</th>
                        <th>Donated By (User / Email)</th>
                        <th>Amount</th>
                        <th class="text-end" style="width: 120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">#GA-@item.Id.ToString("D6")</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@(item.Cause?.CauseName ?? "General Welfare")</strong>
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(item.UserId) ? "Anonymous Guest" : item.UserId)
                                </td>
                                <td>
                                    <span class="fw-bold text-success">PKR @item.Amount.ToString("N0")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                No donations recorded yet. Contributions made through the public Donate page will appear here.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
