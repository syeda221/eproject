@model IEnumerable<GiveAid.Models.Donation>
@{
    ViewData["Title"] = "Donation Records";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Donation Transactions</h3>
        <p class="text-secondary small mb-0">Audited records of all public contributions received.</p>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-success">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Total Funds Collected</small>
            <h3 class="fw-bold text-success mb-0 mt-1">PKR @(((decimal)(ViewBag.TotalFunds ?? 0)).ToString("N0"))</h3>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-primary">
            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Total Contributions Count</small>
            <h3 class="fw-bold text-dark mb-0 mt-1">@(ViewBag.TotalCount ?? 0) Donations</h3>
        </div>
    </div>
</div>

<!-- Donations Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-3 ps-4">Transaction ID</th>
                    <th class="py-3">Welfare Cause</th>
                    <th class="py-3">Donated By (User / Email)</th>
                    <th class="py-3">Amount</th>
                    <th class="py-3 pe-4 text-end" style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="badge bg-light text-dark border px-2 py-1">#GA-@item.Id.ToString("D6")</span>
                            </td>
                            <td>
                                <strong class="text-dark">@(item.Cause?.CauseName ?? "General Welfare")</strong>
                            </td>
                            <td class="text-secondary small">
                                @(string.IsNullOrWhiteSpace(item.UserId) ? "Anonymous Guest" : item.UserId)
                            </td>
                            <td>
                                <span class="fw-bold text-success">PKR @item.Amount.ToString("N0")</span>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <p class="mb-0">No donations recorded yet.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
