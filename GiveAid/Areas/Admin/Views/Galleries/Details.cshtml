@model GiveAid.Models.Gallery
@{
    ViewData["Title"] = "Gallery Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0">Gallery Photo Details</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white" style="max-width: 600px;">
        <div class="mb-3">
            <img src="@Model.ImagePath" class="img-fluid rounded-3 shadow-sm w-100" style="max-height: 320px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1593113598332-cd288d649433?q=80&w=600';" />
        </div>
        <h5 class="fw-bold text-dark mb-3">@Model.Title</h5>
        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm px-3">
                <i class="fas fa-edit me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-light btn-sm px-3">Back</a>
        </div>
    </div>
</div>
