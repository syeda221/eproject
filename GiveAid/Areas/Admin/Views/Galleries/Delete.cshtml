@model GiveAid.Models.Gallery
@{
    ViewData["Title"] = "Delete Gallery Photo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-danger mb-0">Delete Gallery Photo</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white" style="max-width: 600px;">
        <div class="alert alert-warning small">
            <i class="fas fa-exclamation-triangle me-1"></i> Are you sure you want to permanently delete this photo from the gallery?
        </div>
        <div class="mb-3">
            <img src="@Model.ImagePath" class="img-fluid rounded-3 shadow-sm w-100" style="max-height: 280px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1593113598332-cd288d649433?q=80&w=600';" />
        </div>
        <h5 class="fw-bold text-dark mb-3">@Model.Title</h5>
        
        <form asp-action="Delete" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-sm px-4 fw-semibold">
                <i class="fas fa-trash me-1"></i> Confirm Delete
            </button>
            <a asp-action="Index" class="btn btn-light btn-sm px-3 ms-2">Cancel</a>
        </form>
    </div>
</div>
