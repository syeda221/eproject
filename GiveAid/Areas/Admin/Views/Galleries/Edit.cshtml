@model GiveAid.Models.Gallery
@{
    ViewData["Title"] = "Edit Gallery Photo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Edit Gallery Photo</h3>
            <small class="text-muted">Update image title or replace the photo.</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Back to Gallery
        </a>
    </div>

    <div class="row">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImagePath" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Photo Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Current Image Display -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Current Image:</label>
                        <div>
                            <img src="@Model.ImagePath" class="img-thumbnail rounded-3 shadow-sm mb-2" style="max-height: 180px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1593113598332-cd288d649433?q=80&w=400';" />
                        </div>
                    </div>

                    <!-- Upload Replacement Image -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Replace Image (Optional)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Leave empty to keep current image.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light px-3">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
