@model IEnumerable<GiveAid.Models.Cause>

@{
    ViewData["Title"] = "Manage Welfare Causes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Humanitarian Welfare Causes</h3>
        <p class="text-secondary small mb-0">Create and monitor active public donation appeals.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-pill px-4 fw-semibold shadow-sm">
        <i class="fas fa-plus me-1"></i> Add New Cause
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="py-3 ps-4" style="width: 10%;">ID</th>
                    <th class="py-3" style="width: 60%;">Cause Appeal Name</th>
                    <th class="py-3 pe-4 text-end" style="width: 30%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                                        <i class="fas fa-hand-holding-heart"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.CauseName</span>
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <p class="mb-0">No welfare causes found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
