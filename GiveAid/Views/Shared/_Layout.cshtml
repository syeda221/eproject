<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GiveAid NGO Welfare Network</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiveAid.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Clean Deep Navy Navigation Bar -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark giveaid-navbar py-2 py-lg-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-white d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="letter-spacing: -0.5px;">Give<span style="color: #38bdf8;">Aid</span></span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Donate" asp-action="Index">Donate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Partners">Our Partners</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="HelpCentre">Help Centre</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-area="" asp-controller="Donate" asp-action="Index" class="btn btn-cyan btn-pill btn-sm px-4 fw-bold shadow-sm d-none d-md-inline-block">
                            DONATE
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast / Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Clean Humanitarian Footer (Matching Reference Layout) -->
    <footer class="clean-footer">
        <div class="container text-center mb-4">
            <!-- Social Circle Icons -->
            <div class="d-flex justify-content-center gap-3 mb-4">
                <a href="#" class="social-pill" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="social-pill" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                <a href="#" class="social-pill" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" class="social-pill" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                <a href="#" class="social-pill" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
            </div>

            <!-- Quick Action Row -->
            <div class="row justify-content-center mb-4">
                <div class="col-md-8 col-lg-6 d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-area="" asp-controller="Donate" asp-action="Index" class="btn btn-sm btn-forest btn-pill px-4">DONATE</a>
                    <a asp-area="" asp-controller="Home" asp-action="Partners" class="btn btn-sm btn-outline-dark btn-pill px-4">OUR PARTNERS</a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-sm btn-crimson btn-pill px-4">SIGN UP</a>
                </div>
            </div>

            <!-- Multi-Column Clean Navigation -->
            <div class="row g-3 text-start justify-content-center mb-4 pt-3 border-top">
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2">About GiveAid</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">What We Do</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">Our Mission</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">Leadership Team</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">Achievements</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2">Get Involved</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Donate" asp-action="Index">Make a Donation</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="Partners">Corporate Partners</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="Index">Volunteer Programmes</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="Identity" asp-page="/Account/Register">Register NGO</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2">Help & Support</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="HelpCentre">Help Centre & FAQs</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="HelpCentre">Submit Query</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">Supporters & Donors</a></li>
                        <li class="mb-1"><a class="text-secondary" asp-area="" asp-controller="Home" asp-action="About">Careers & Volunteering</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="fw-bold text-dark text-uppercase small mb-2">Contact & Helpline</h6>
                    <p class="small text-muted mb-1"><i class="fas fa-map-marker-alt text-primary me-1"></i> GiveAid Welfare Trust, Suite 500</p>
                    <p class="small text-muted mb-1"><i class="fas fa-envelope text-primary me-1"></i> info@giveaid.org</p>
                    <p class="small text-muted mb-0"><i class="fas fa-phone text-primary me-1"></i> +1 (800) 555-4483</p>
                </div>
            </div>

            <!-- Tax-Exempt Legal Statement -->
            <p class="small text-muted mb-0" style="font-size: 0.8rem;">
                GiveAid is a registered non-profit welfare organization (Tax ID: 84-1234567). All contributions are transparently audited and allocated directly to certified community causes.
            </p>
        </div>

        <!-- Deep Navy Copyright Bar -->
        <div class="clean-footer-bottom text-center">
            <div class="container d-flex flex-wrap justify-content-between align-items-center">
                <span>&copy; @DateTime.UtcNow.Year GiveAid Welfare Portal. All rights reserved.</span>
                <span>Transparent NGO & Volunteer Welfare Network</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
