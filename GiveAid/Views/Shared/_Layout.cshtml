<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GiveAid NGO Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiveAid.styles.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --accent-green: #198754;
            --dark-navy: #0f172a;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #334155;
        }
        .navbar-brand {
            letter-spacing: -0.5px;
        }
        .nav-link {
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }
        .btn {
            font-weight: 500;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="sticky-top shadow-sm">
        @*
        <!-- Top Info Bar -->
        <div class="bg-dark text-white-50 py-1 px-3 small border-bottom border-secondary border-opacity-25">
            <div class="container d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-light"><i class="fas fa-globe-americas me-1 text-primary"></i> United NGO Welfare Network</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="#inviteModal" data-bs-toggle="modal" class="text-white-50 text-decoration-none hover-white">
                        <i class="fas fa-envelope me-1"></i> Invite a Friend
                    </a>
                    <span><i class="fas fa-phone-alt me-1"></i> +1 (800) 555-4483</span>
                </div>
            </div>
        </div>
        *@

        <!-- Main Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-2">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    Give<span class="text-primary">Aid</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-semibold" asp-area="" asp-controller="Donate" asp-action="Index">Donate</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="HelpCentre">Help Centre</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="About">About us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Partners">Our Partners</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast / Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Modal: Invite a Friend -->
    <div class="modal fade" id="inviteModal" tabindex="-1" aria-labelledby="inviteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-area="" asp-controller="Home" asp-action="InviteFriend" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-dark text-white">
                        <h6 class="modal-title fw-bold" id="inviteModalLabel"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Invite Friends to Join GiveAid</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">Invite colleagues, friends, or family members to support humanitarian causes and community welfare.</p>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Friend's Email Address <span class="text-danger">*</span></label>
                            <input type="email" name="friendEmail" class="form-control" placeholder="friend@example.com" required />
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary px-3"><i class="fas fa-paper-plane me-1"></i> Send Invitation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Clean Footer -->
    <footer class="bg-dark text-white pt-5 pb-4 border-top border-secondary border-opacity-25 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-2">Give<span class="text-primary">Aid</span></h5>
                    <p class="text-white-50 small mb-3">
                        GiveAid connects donors, certified NGOs, and welfare volunteers into one transparent platform to deliver immediate relief and sustainable community support.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-sm btn-outline-secondary text-white rounded-circle"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-secondary text-white rounded-circle"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-secondary text-white rounded-circle"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="btn btn-sm btn-outline-secondary text-white rounded-circle"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-uppercase fw-bold text-light small mb-3">Navigation</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-area="" asp-controller="Donate" asp-action="Index">Donate</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-area="" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Partners">Our Partners</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-area="" asp-controller="Home" asp-action="HelpCentre">Help Centre</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-uppercase fw-bold text-light small mb-3">Welfare Sectors</h6>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2"><i class="fas fa-angle-right me-1 text-primary"></i> Child Nutrition & Care</li>
                        <li class="mb-2"><i class="fas fa-angle-right me-1 text-primary"></i> Special Education & Kits</li>
                        <li class="mb-2"><i class="fas fa-angle-right me-1 text-primary"></i> Free Health Diagnostic Camps</li>
                        <li class="mb-2"><i class="fas fa-angle-right me-1 text-primary"></i> Specially Challenged Aid</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-light small mb-3">Contact Support</h6>
                    <p class="text-white-50 small mb-1"><i class="fas fa-map-marker-alt text-primary me-2"></i> 124 Welfare Boulevard, Suite 500</p>
                    <p class="text-white-50 small mb-1"><i class="fas fa-envelope text-primary me-2"></i> contact@giveaid.org</p>
                    <p class="text-white-50 small"><i class="fas fa-phone text-primary me-2"></i> +1 (800) 555-4483</p>
                </div>
            </div>
            <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center small text-white-50">
                <div>&copy; 2026 GiveAid Portal. All rights reserved.</div>
                <div>Transparency & Accountability in Philanthropy.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
