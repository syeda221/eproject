@model GiveAid.Models.Donation
@{
    ViewData["Title"] = "Donation Successful";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 text-center p-4 p-md-5">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 80px; height: 80px;">
                        <i class="fas fa-check fa-3x"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-1">Thank You for Your Generosity!</h2>
                <p class="text-muted mb-4">Your donation has been successfully processed & confirmed.</p>

                <!-- Receipt Box -->
                <div class="bg-light p-4 rounded-3 text-start mb-4 border">
                    <h6 class="text-uppercase fw-bold text-primary mb-3"><i class="fas fa-receipt me-2"></i>Donation Receipt</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Transaction ID:</span>
                        <span class="fw-semibold">#GA-@Model.Id.ToString("D6")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Cause:</span>
                        <span class="fw-semibold text-dark">@(Model.Cause?.CauseName ?? "General Welfare")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Amount Contributed:</span>
                        <span class="fw-bold text-success fs-5">PKR @Model.Amount.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Payment Status:</span>
                        <span class="badge bg-success">Verified & Cleared</span>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">
                        <i class="fas fa-home me-1"></i> Back to Home
                    </a>
                    <a asp-controller="Donate" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-hand-holding-heart me-1"></i> Donate Again
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
