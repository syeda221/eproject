@{
    ViewData["Title"] = "About Us - Give-AID";
}

<div class="container py-5">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4 p-md-5 mb-5 text-center">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 align-self-center">
            <i class="fas fa-info-circle me-1"></i> Who We Are
        </span>
        <h1 class="display-5 fw-bold mb-2">About Give-AID Foundation</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 750px;">
            A unified humanitarian platform bringing together the finest NGOs to coordinate welfare, healthcare, education, and emergency aid for vulnerable communities.
        </p>
    </div>

    <!-- Navigation Tabs / 7 Subsections -->
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="list-group shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <a class="list-group-item list-group-item-action active fw-bold py-3" href="#whatWeDo"><i class="fas fa-hand-holding-heart me-2"></i>1. What We Do</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourMission"><i class="fas fa-bullseye me-2"></i>2. Our Mission</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourTeam"><i class="fas fa-users me-2"></i>3. Our Team</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#careerWithUs"><i class="fas fa-briefcase me-2"></i>4. Career With Us</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourAchievements"><i class="fas fa-trophy me-2"></i>5. Our Achievements</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourSupporters"><i class="fas fa-handshake me-2"></i>6. Our Supporters</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#readAboutUs"><i class="fas fa-book-open me-2"></i>7. Read About Us</a>
            </div>
        </div>

        <div class="col-lg-9">
            <!-- 1. What We Do -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="whatWeDo">
                <h3 class="fw-bold text-primary mb-3"><i class="fas fa-hand-holding-heart me-2"></i>1. What We Do</h3>
                <p class="text-muted">
                    Give-AID serves as a unified umbrella linking donors, volunteers, and certified non-governmental organizations. We channel verified funds directly into impactful grassroots projects:
                </p>
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="fas fa-book-reader text-warning fa-2x mb-2"></i>
                            <h6 class="fw-bold">Free Education</h6>
                            <p class="small text-muted mb-0">Providing books, tuition, and school kits to underprivileged children.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="fas fa-stethoscope text-danger fa-2x mb-2"></i>
                            <h6 class="fw-bold">Healthcare Camps</h6>
                            <p class="small text-muted mb-0">Free medical checkups, medicines, and specialized child care.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 text-center h-100">
                            <i class="fas fa-wheelchair text-primary fa-2x mb-2"></i>
                            <h6 class="fw-bold">Specially Challenged Aid</h6>
                            <p class="small text-muted mb-0">Rehabilitation, prosthetics, and supportive equipment.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Our Mission -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourMission">
                <h3 class="fw-bold text-success mb-3"><i class="fas fa-bullseye me-2"></i>2. Our Mission & Vision</h3>
                <p class="text-muted">
                    <strong>Our Mission:</strong> To bridge the gap between compassionate donors and high-impact welfare causes through total transparency, cutting-edge digital integration, and accountable distribution.
                </p>
                <p class="text-muted mb-0">
                    <strong>Our Vision:</strong> A society where no child is deprived of schooling, no patient lacks medical attention due to poverty, and all specially-abled individuals live with dignity and self-reliance.
                </p>
            </div>

            <!-- 3. Our Team -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourTeam">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-users me-2"></i>3. Our Team</h3>
                <p class="text-muted mb-4">Our leadership comprises passionate humanitarians, development strategists, and tech innovators.</p>
                <div class="row g-3">
                    <div class="col-md-4 text-center">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=250" class="rounded-circle mb-2 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Dr. Sarah Jenkins" />
                        <h6 class="fw-bold mb-0">Dr. Sarah Jenkins</h6>
                        <small class="text-muted">Executive Director</small>
                    </div>
                    <div class="col-md-4 text-center">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=250" class="rounded-circle mb-2 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Farhan Ahmed" />
                        <h6 class="fw-bold mb-0">Farhan Ahmed</h6>
                        <small class="text-muted">Head of NGO Partnerships</small>
                    </div>
                    <div class="col-md-4 text-center">
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=250" class="rounded-circle mb-2 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Elena Vance" />
                        <h6 class="fw-bold mb-0">Elena Vance</h6>
                        <small class="text-muted">Director of Welfare Field Operations</small>
                    </div>
                </div>
            </div>

            <!-- 4. Career With Us -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="careerWithUs">
                <h3 class="fw-bold text-info mb-3"><i class="fas fa-briefcase me-2"></i>4. Career With Us</h3>
                <p class="text-muted">
                    We are always seeking passionate changemakers, field coordinators, social workers, and software engineers to expand our mission.
                </p>
                <div class="p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-1">Open Positions: Social Media Lead & Field Volunteer Coordinator</h6>
                        <small class="text-muted">Full-time & Internship positions available</small>
                    </div>
                    <a href="mailto:careers@giveaid.org" class="btn btn-sm btn-outline-primary rounded-pill">Apply Via Email</a>
                </div>
            </div>

            <!-- 5. Our Achievements -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourAchievements">
                <h3 class="fw-bold text-warning mb-3"><i class="fas fa-trophy me-2"></i>5. Our Achievements</h3>
                <ul class="list-unstyled text-muted">
                    <li class="mb-2"><i class="fas fa-star text-warning me-2"></i>Over <strong>$2.5M+</strong> in transparently disbursed micro-donations.</li>
                    <li class="mb-2"><i class="fas fa-star text-warning me-2"></i>Supported over <strong>45,000+</strong> school children with study equipment across 12 regions.</li>
                    <li class="mb-2"><i class="fas fa-star text-warning me-2"></i>Conducted <strong>150+ Free Health & Diagnostic Camps</strong> in remote villages.</li>
                </ul>
            </div>

            <!-- 6. Our Supporters -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourSupporters">
                <h3 class="fw-bold text-primary mb-3"><i class="fas fa-handshake me-2"></i>6. Our Supporters & Corporate Donors</h3>
                <p class="text-muted">
                    Give-AID has been established with the generous contributions and CSR grants of premier technology, banking, and retail corporations.
                </p>
                <a asp-action="Partners" class="btn btn-outline-primary btn-sm rounded-pill">
                    <i class="fas fa-external-link-alt me-1"></i> View All Corporate Partners
                </a>
            </div>

            <!-- 7. Read About Us -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="readAboutUs">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-book-open me-2"></i>7. Read About Us</h3>
                <p class="text-muted mb-0">
                    Founded in 2026, Give-AID remains the single trusted hub connecting citizen donors with certified NGOs. By eliminating bureaucratic delays and verifying every single cause, we ensure your kindness directly saves lives.
                </p>
            </div>
        </div>
    </div>
</div>
