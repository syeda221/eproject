@{
    ViewData["Title"] = "About Us - GiveAid Welfare Foundation";
}

<div class="container py-4 py-md-5">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 text-white p-4 p-md-5 mb-5 text-center" style="background: linear-gradient(135deg, #001f3f 0%, #002855 100%);">
        <span class="badge bg-cyan text-white px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 align-self-center">
            <i class="fas fa-info-circle me-1"></i> Who We Are
        </span>
        <h1 class="display-5 fw-bold mb-2">About GiveAid Foundation</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 750px;">
            A unified humanitarian network bringing together certified NGOs to coordinate welfare, healthcare, education, and emergency aid for vulnerable communities.
        </p>
    </div>

    <!-- Navigation Tabs / 7 Subsections -->
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="list-group shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <a class="list-group-item list-group-item-action active fw-bold py-3 bg-dark border-dark" href="#whatWeDo"><i class="fas fa-hand-holding-heart me-2 text-primary"></i>1. What We Do</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourMission"><i class="fas fa-bullseye me-2 text-primary"></i>2. Our Mission</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourTeam"><i class="fas fa-users me-2 text-primary"></i>3. Our Team</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#careerWithUs"><i class="fas fa-briefcase me-2 text-primary"></i>4. Career With Us</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourAchievements"><i class="fas fa-trophy me-2 text-primary"></i>5. Our Achievements</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#ourSupporters"><i class="fas fa-handshake me-2 text-primary"></i>6. Our Supporters</a>
                <a class="list-group-item list-group-item-action fw-semibold py-3" href="#readAboutUs"><i class="fas fa-book-open me-2 text-primary"></i>7. Read About Us</a>
            </div>
        </div>

        <div class="col-lg-9">
            <!-- 1. What We Do -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="whatWeDo">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-hand-holding-heart text-primary me-2"></i>1. What We Do</h3>
                <p class="text-secondary">
                    GiveAid serves as a unified umbrella linking donors, volunteers, and certified non-governmental organizations. We channel verified funds directly into impactful grassroots projects:
                </p>
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center h-100 border">
                            <i class="fas fa-book-reader text-warning fa-2x mb-2"></i>
                            <h6 class="fw-bold text-dark">Free Education</h6>
                            <p class="small text-muted mb-0">Providing books, tuition, and school kits to underprivileged children.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center h-100 border">
                            <i class="fas fa-stethoscope text-danger fa-2x mb-2"></i>
                            <h6 class="fw-bold text-dark">Healthcare Camps</h6>
                            <p class="small text-muted mb-0">Free medical checkups, medicines, and specialized child care.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 text-center h-100 border">
                            <i class="fas fa-wheelchair text-primary fa-2x mb-2"></i>
                            <h6 class="fw-bold text-dark">Specially Challenged Aid</h6>
                            <p class="small text-muted mb-0">Rehabilitation, prosthetics, and supportive equipment.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Our Mission -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourMission">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-bullseye text-primary me-2"></i>2. Our Mission</h3>
                <p class="lead text-secondary fs-6">
                    Our mission is to eliminate barriers preventing marginalized individuals from accessing healthcare, quality education, and clean nutrition through digital transparency.
                </p>
                <div class="p-3 rounded-4 border-start border-primary border-4 bg-light">
                    <em>"Transparent philanthropy empowers communities to rise out of poverty sustainably."</em>
                </div>
            </div>

            <!-- 3. Our Team -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourTeam">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-users text-primary me-2"></i>3. Our Team</h3>
                <p class="text-secondary mb-4">Dedicated professionals, social workers, and volunteer leaders managing operations on the ground:</p>
                <div class="row g-3">
                    <div class="col-md-4 text-center">
                        <div class="p-3 bg-light rounded-4 border">
                            <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 55px; height: 55px;">
                                <i class="fas fa-user fa-lg"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0">Sarah Jenkins</h6>
                            <small class="text-muted">Executive Director</small>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="p-3 bg-light rounded-4 border">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 55px; height: 55px;">
                                <i class="fas fa-user-md fa-lg"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0">Dr. Tariq Mahmood</h6>
                            <small class="text-muted">Medical Relief Head</small>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="p-3 bg-light rounded-4 border">
                            <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 55px; height: 55px;">
                                <i class="fas fa-hands-helping fa-lg"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0">Amina Khan</h6>
                            <small class="text-muted">Volunteer Coordinator</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Career With Us -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="careerWithUs">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-briefcase text-primary me-2"></i>4. Career With Us</h3>
                <p class="text-secondary">Join our team of social workers, campaign managers, and tech coordinators making a daily impact.</p>
                <div class="list-group">
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-3 mb-2 border">
                        <div>
                            <h6 class="mb-1 fw-bold text-dark">Field Medical Camp Coordinator</h6>
                            <small class="text-muted">Full-time &bull; Lahore &bull; NGO Health Division</small>
                        </div>
                        <a asp-controller="Home" asp-action="HelpCentre" class="btn btn-sm btn-outline-dark btn-pill">Apply Now</a>
                    </div>
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center rounded-3 border">
                        <div>
                            <h6 class="mb-1 fw-bold text-dark">Community Volunteer Lead</h6>
                            <small class="text-muted">Part-time / Volunteer &bull; Karachi &bull; Welfare Outreach</small>
                        </div>
                        <a asp-controller="Home" asp-action="HelpCentre" class="btn btn-sm btn-outline-dark btn-pill">Apply Now</a>
                    </div>
                </div>
            </div>

            <!-- 5. Our Achievements -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourAchievements">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-trophy text-warning me-2"></i>5. Our Achievements</h3>
                <div class="row g-3 text-center">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 border">
                            <h4 class="fw-bold text-dark mb-0">5,800,000+</h4>
                            <small class="text-muted">Beneficiaries Reached</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 border">
                            <h4 class="fw-bold text-success mb-0">120+</h4>
                            <small class="text-muted">Health Camps Completed</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 border">
                            <h4 class="fw-bold text-primary mb-0">45+</h4>
                            <small class="text-muted">Certified NGO Partners</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 6. Our Supporters -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="ourSupporters">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-handshake text-primary me-2"></i>6. Our Supporters</h3>
                <p class="text-secondary">We are grateful to our philanthropic partners, private donors, and civic organizations who fund operational audits and matching grants.</p>
                <a asp-controller="Home" asp-action="Partners" class="btn btn-outline-primary btn-pill btn-sm">Explore Partner Organizations &rarr;</a>
            </div>

            <!-- 7. Read About Us -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" id="readAboutUs">
                <h3 class="fw-bold text-dark mb-3"><i class="fas fa-book-open text-primary me-2"></i>7. Read About Us in the Media</h3>
                <p class="text-secondary">Featured in National Philanthropy Reports and Welfare News for transparency in online donation tracking and volunteer mobilization.</p>
                <div class="alert alert-light border rounded-4 small">
                    <i class="fas fa-newspaper text-primary me-2"></i><strong>Annual Welfare Review:</strong> "GiveAid sets a new benchmark for accountability in multi-NGO management."
                </div>
            </div>
        </div>
    </div>
</div>
