@{
    ViewData["Title"] = "Our Partners - GiveAid";
}

<div class="container py-4 py-md-5">
    <div class="card border-0 shadow-sm rounded-4 text-white p-4 p-md-5 mb-5 text-center" style="background: linear-gradient(135deg, #001f3f 0%, #002855 100%);">
        <span class="badge bg-cyan text-white px-3 py-2 rounded-pill fw-bold text-uppercase mb-3 align-self-center">
            <i class="fas fa-handshake me-1"></i> Corporate Collaboration
        </span>
        <h1 class="display-5 fw-bold mb-2">Our Strategic Partners & Corporate Allies</h1>
        <p class="lead text-white-50 mx-auto mb-0" style="max-width: 700px;">
            GiveAid is proudly powered by the CSR grants and collaborative efforts of major organizations dedicated to uplifting community welfare.
        </p>
    </div>

    <!-- Partner Companies Grid -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-building text-primary fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">TechCorp Global</h5>
                <span class="badge bg-success bg-opacity-10 text-success mb-3">Technology & Infrastructure</span>
                <p class="text-secondary small mb-0">Providing digital servers, connectivity, and digital classrooms across 50 remote community schools.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-heartbeat text-danger fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Apex Healthcare Network</h5>
                <span class="badge bg-danger bg-opacity-10 text-danger mb-3">Medical Supplies Partner</span>
                <p class="text-secondary small mb-0">Supplying free essential pharmaceuticals, diagnostics kits, and volunteer doctors for health camps.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-seedling text-success fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">GreenEarth Agro Foods</h5>
                <span class="badge bg-success bg-opacity-10 text-success mb-3">Nutrition & Rations Partner</span>
                <p class="text-secondary small mb-0">Funding nutritious monthly food packages for orphaned children and impoverished families.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-university text-warning fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Horizon Banking Group</h5>
                <span class="badge bg-warning bg-opacity-10 text-dark mb-3">Financial Grant Partner</span>
                <p class="text-secondary small mb-0">Ensuring zero transaction fee matching grants on all educational micro-donations.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-truck text-info fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">SwiftLogistics Express</h5>
                <span class="badge bg-info bg-opacity-10 text-info mb-3">Relief Transport Partner</span>
                <p class="text-secondary small mb-0">Managing end-to-end transport and safe delivery of emergency supplies and medicine.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4 bg-white">
                <div class="p-3 bg-light rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-graduation-cap text-primary fa-2x"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Universal Publishers</h5>
                <span class="badge bg-primary bg-opacity-10 text-primary mb-3">Books & Educational Aid</span>
                <p class="text-secondary small mb-0">Donating over 10,000 educational books, science kits, and stationery to community centers.</p>
            </div>
        </div>
    </div>
</div>
